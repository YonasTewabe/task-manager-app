@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  button {
    @apply rounded-[10px] px-3;
    min-height: 32px;
    line-height: 1.2;
  }

  button:not([class*="w-"]) {
    min-width: 40px;
  }

  button:not([class]),
  button[class=""] {
    @apply border border-[#0b63c5] bg-[#0b6bcb] text-white transition-[background-color,border-color,box-shadow] duration-150;
  }

  button:not([class]):hover:not(:disabled),
  button[class=""]:hover:not(:disabled) {
    @apply border-[#0957a3] bg-[#095db2];
  }

  button:focus-visible {
    @apply outline-none ring-2 ring-[#8ec1ff] ring-offset-1;
  }

  button:disabled {
    @apply cursor-not-allowed opacity-60;
  }
}
