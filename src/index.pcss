@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --tm-bg: #f4f5f7;
    --tm-bg-soft: #f8fafc;
    --tm-surface: #ffffff;
    --tm-border: #d9e1ee;
    --tm-text: #172b4d;
    --tm-text-soft: #5e6c84;
    --tm-primary: #0c66e4;
    --tm-primary-strong: #0055cc;
  }

  html,
  body {
    background: radial-gradient(circle at top, #f7faff 0%, var(--tm-bg) 42%);
    color: var(--tm-text);
  }

  body {
    font-feature-settings:
      "cv11" 1,
      "ss01" 1;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    text-transform: capitalize;
  }

  button {
    @apply rounded-[10px] px-3;
    min-height: 32px;
    line-height: 1.2;
  }

  button:not([class*="w-"]) {
    min-width: 40px;
  }

  button:not([class]),
  button[class=""] {
    @apply border text-white transition-[background-color,border-color,box-shadow] duration-150;
    border-color: var(--tm-primary-strong);
    background: var(--tm-primary);
    box-shadow: 0 1px 0 rgba(9, 30, 66, 0.15);
  }

  button:not([class]):hover:not(:disabled),
  button[class=""]:hover:not(:disabled) {
    background: var(--tm-primary-strong);
    border-color: #0047b3;
  }

  button:focus-visible {
    @apply outline-none ring-2 ring-[#8ec1ff] ring-offset-1;
  }

  button:disabled {
    @apply cursor-not-allowed opacity-60;
  }

  input,
  select,
  textarea {
    @apply rounded-[10px] border border-[#c9d5ea] bg-white px-[0.72rem] py-[0.52rem] text-[0.92rem] text-[#172b4d] outline-none transition-[box-shadow,border-color] duration-150;
  }

  input::placeholder,
  textarea::placeholder {
    color: #7a869a;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-color: #afc3e6;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: #2f6feb;
    box-shadow: 0 0 0 3px rgba(47, 111, 235, 0.2);
  }
}

/* Scoped fallback: keep automation branch radios compact/inline. */
.branch-filter-options {
  display: grid;
  gap: 8px;
}

.branch-scope-option {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: fit-content;
  color: #42526e;
  font-size: 0.88rem;
}

.branch-scope-option > input[type="radio"] {
  width: 16px !important;
  min-width: 16px !important;
  height: 16px !important;
  min-height: 16px !important;
  margin: 0 !important;
  padding: 0 !important;
  flex: 0 0 auto !important;
  display: inline-block !important;
  accent-color: #0c66e4;
}

[contenteditable="true"][data-placeholder]:empty::before {
  content: attr(data-placeholder);
  color: #7a869a;
  pointer-events: none;
}
