# Server
PORT=4000
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=task_manager
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# GitHub
GITHUB_API_BASE=https://api.github.com
GITHUB_ORG=your-org
GITHUB_TOKEN=your-github-token

# Jenkins
JENKINS_BASE_URL=http://jenkins.example.com
JENKINS_USER=your-jenkins-user
JENKINS_PASSWORD=your-jenkins-password
JENKINS_JOB_NAME=your-jenkins-job
JENKINS_TRIGGER_TOKEN=your-trigger-token
