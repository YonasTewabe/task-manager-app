# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=task_manager
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/task_manager?schema=public

# Authentication
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=100MB

# Frontend/CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Browser Push (VAPID)
PUSH_VAPID_SUBJECT=mailto:your_email@example.com
PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
